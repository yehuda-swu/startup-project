rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function team(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
    }
    function canAccess(teamId) {
      return signedIn() && (
        profile().role == 'admin' ||
        request.auth.uid in team(teamId).memberUids ||
        request.auth.uid in team(teamId).supervisorUids
      );
    }
    match /teams/{teamId}/{ownerUid}/{fileName} {
      allow read: if canAccess(teamId);
      allow create: if canAccess(teamId) && request.auth.uid == ownerUid &&
        request.resource.size < 15 * 1024 * 1024 &&
        request.resource.contentType.matches(
          'application/pdf|application/vnd.openxmlformats-officedocument.presentationml.presentation|application/vnd.openxmlformats-officedocument.wordprocessingml.document|application/vnd.ms-powerpoint|application/msword|image/png|image/jpeg'
        );
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == ownerUid && canAccess(teamId);
    }
  }
}
